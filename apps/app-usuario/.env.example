# Supabase publico para Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox publico para geocodificacion/rutas
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE_URL=
# Stripe publico para montar Elements en el navegador
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Capacitor opcional para builds que apuntan a otro ambiente
RUUM_CAPACITOR_SERVER_URL=

#Resend
RESEND_API_KEY=

# Didit se configura como secreto de las Edge Functions de Supabase.
# Nunca expongas DIDIT_API_KEY ni DIDIT_WEBHOOK_SECRET como NEXT_PUBLIC_*.

#MessageBird#
NEXT_PUBLIC_MESSAGEBIRD_API_KEY=

# R14: rate-limit distribuido CSP report — Vercel KV (Upstash Redis)
# En Vercel, configurar KV_REST_API_URL + KV_REST_API_TOKEN (o UPSTASH_REDIS_REST_URL + TOKEN)
# Sin esto, el endpoint usa memoria local (no distribuido, solo dev/test)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
