# Contactos de prueba para staging/desarrollo. Deben verse marcados como "(pruebas)".
NEXT_PUBLIC_RUUM_AMBIENTE=staging
NEXT_PUBLIC_RUUM_SOPORTE_TELEFONO=5500000000
NEXT_PUBLIC_RUUM_SOPORTE_CORREO=soporte-conductores-pruebas@example.test
NEXT_PUBLIC_RUUM_EMERGENCIA_TELEFONO=5500000911

# CSP estricto — ventana 7d iniciada 2026-08-24 (SEC-003). stile-src sin unsafe-inline, solo nonce.
# Ver CSP_DEUDA_P2.md y docs/adr/001-csp-nonce-strict-dynamic.md
CSP_STRICT_STYLES=true
NEXT_PUBLIC_CSP_STRICT_STYLES=true

# SemVer visible para observabilidad y control de compatibilidad — debe coincidir con config/app-version.json
NEXT_PUBLIC_APP_VERSION=1.0.0
