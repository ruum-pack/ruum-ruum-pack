PLAYWRIGHT_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Fallback variables (compatibilidad)
E2E_CONDUCTOR_EMAIL=conductor-e2e@ruumruum.test
E2E_CONDUCTOR_PASSWORD=your-e2e-password-here
